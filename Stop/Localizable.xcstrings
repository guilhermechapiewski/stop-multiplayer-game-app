{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ hasn’t sent answers. Continue anyway?" : {
      "comment" : "Host confirmation on the collecting screen, one player missing. %@ is the player's name.",
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ainda não enviou as respostas. Continuar mesmo assim?"
          }
        }
      }
    },
    "%@ haven’t sent answers. Continue anyway?" : {
      "comment" : "Host confirmation on the collecting screen, several players missing. %@ is a list of names, e.g. \"Ana and Bia\".",
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ainda não enviaram as respostas. Continuar mesmo assim?"
          }
        }
      }
    },
    "%@ is back" : {
      "comment" : "Banner when a player who was away reconnects. %@ is the player's name.",
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ voltou"
          }
        }
      }
    },
    "%@ leaves the game. Their points so far stay in the standings." : {
      "comment" : "Message when the host confirms removing a player. %@ is the player's name.",
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ sai do jogo. Os pontos até agora continuam na classificação."
          }
        }
      }
    },
    "%@ left the app" : {
      "comment" : "Banner when another player puts the app in the background or drops off. %@ is the player's name.",
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ saiu do app"
          }
        }
      }
    },
    "%@ left the game" : {
      "comment" : "Banner when a player taps Leave game. %@ is the player's name.",
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ saiu do jogo"
          }
        }
      }
    },
    "%@ tie!" : {
      "comment" : "Game over title when several other players share first place. %@ is a list of names, e.g. \"Ana and Bia\".",
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empate: %@!"
          }
        }
      }
    },
    "%@ was removed" : {
      "comment" : "Banner when the host removes a player. %@ is the player's name.",
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ foi removido(a)"
          }
        }
      }
    },
    "%@ wins!" : {
      "comment" : "Game over title. %@ is the winner's name.",
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ venceu!"
          }
        }
      }
    },
    "%@%@" : {
      "comment" : "Joins two styled pieces of text (a name and its badges). Not translated.",
      "shouldTranslate" : false
    },
    "%@, %lld points" : {
      "comment" : "VoiceOver value of a scoring row once that player has a score. %@ is the answer, %lld the points (10, 5 or 0).",
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, %2$lld pontos"
          }
        }
      }
    },
    "%@, not scored yet" : {
      "comment" : "VoiceOver value of a scoring row. %@ is the answer.",
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, ainda sem pontuação"
          }
        }
      }
    },
    "%@’s game" : {
      "comment" : "Name of a game in the Join list and the lobby title for guests. %@ is the host's name.",
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jogo de %@"
          }
        }
      }
    },
    "%lld of %lld" : {
