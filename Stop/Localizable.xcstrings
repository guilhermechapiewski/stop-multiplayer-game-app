    "(you)" : {
      "comment" : "Next to the local player's name in scoring and standings.",
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(você)"
          }
        }
      }
    },
    "A solo game on this phone. No network needed." : {
      "comment" : "Footer on practice setup explaining practice mode.",
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jogue sozinho neste celular. Não precisa de rede."
          }
        }
      }
    },
    "About" : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sobre"
          }
        }
      },
      "comment" : "Settings row that opens the About screen; also its title."
    },
    "About silent mode" : {
      "comment" : "VoiceOver label of the ⓘ button beside the Silent mode switch; it opens an explanation.",
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sobre o modo silencioso"
          }
        }
      }
    },
    "Add" : {
      "comment" : "Button that adds the typed custom category.",
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicionar"
          }
        }
      }
    },
    "Add your own category" : {
      "comment" : "Placeholder of the custom category field in game setup.",
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione sua própria categoria"
          }
        }
      }
    },
    "Adds this category to the game." : {
      "comment" : "VoiceOver hint for an unselected category in game setup.",
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adiciona esta categoria ao jogo."
          }
        }
      }
    },
    "Allow Local Network access" : {
      "comment" : "Title when the app was denied Local Network access.",
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permita o acesso à rede local"
          }
        }
      }
    },
    "Allow giving up" : {
      "comment" : "Toggle: whether giving up counts as a stop.",
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permitir desistir"
          }
        }
      }
    },
    "Allowed" : {
      "comment" : "Lobby rules (guest view): giving up is allowed.",
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permitida"
          }
        }
      }
    },
    "Answer hidden until scored" : {
      "comment" : "VoiceOver value of a scoring row in read-aloud mode while that player hasn't scored yet (read after the name).",
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resposta escondida até a nota"
          }
        }
      }
    },
    "Ask a friend to host a game. It shows up here as soon as their phone is on the same Wi-Fi network as yours." : {
      "comment" : "Join screen while no games have been found.",
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peça para um amigo criar um jogo. Ele aparece aqui assim que o celular dele estiver na mesma rede Wi-Fi que o seu."
          }
        }
      }
    },
    "Asks to confirm leaving the game." : {
      "comment" : "VoiceOver hint for the Leave game button when the host may be gone.",
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pede para confirmar a saída do jogo."
          }
        }
      }
    },
    "Asks to confirm removing this player." : {
      "comment" : "VoiceOver hint for a player in the Remove a player sheet.",
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pede confirmação para remover este jogador."
          }
        }
      }
    },
    "Available once everyone has scored." : {
      "comment" : "VoiceOver hint of the host's Next category button while it is disabled.",
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disponível quando todo mundo tiver pontuado."
          }
        }
      }
    },
    "Away — score for %@" : {
      "comment" : "Host-only control in scoring for a player who is away. %@ is the player's name.",
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ausente — pontue por %@"
          }
        }
      }
    },
    "Back to Home" : {
      "comment" : "Button that leaves an ended game and returns to the start screen.",
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voltar ao início"
          }
        }
      }
    },
    "Back to scoring" : {
      "comment" : "Host button on round results: reopens the round's last scoring category so a score can be corrected.",
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rever notas"
          }
        }
      }
    },
    "Blank" : {
      "comment" : "VoiceOver value of an answer left blank.",
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Em branco"
          }
        }
      }
    },
    "Blank answers score 0." : {
      "comment" : "Error toast; also the caption under the score picker for a blank answer.",
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Respostas em branco valem 0."
          }
        }
      }
    },
    "Bot" : {
      "comment" : "VoiceOver detail on a player chip: a computer player in a practice game.",
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Robô"
          }
        }
      }
    },
    "Bot speed" : {
      "comment" : "Section header and picker label on practice setup.",
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velocidade dos robôs"
          }
        }
      }
    },
    "Bots" : {
      "comment" : "Stepper label on practice setup: how many computer players join (1 to 5).",
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Robôs"
          }
        }
      }
    },
    "Bots call STOP after 20 to 35 seconds. Think fast!" : {
      "comment" : "Description of the Fast bot speed. Keep the word STOP as is.",
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os robôs pedem STOP depois de 20 a 35 segundos. Pense rápido!"
          }
        }
      }
    },
    "Bots call STOP after about 35 to 60 seconds." : {
      "comment" : "Description of the Normal bot speed. Keep the word STOP as is.",
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os robôs pedem STOP depois de uns 35 a 60 segundos."
          }
        }
      }
    },
    "Bots don’t know your own categories — they guess there and score 0." : {
      "comment" : "Footer on practice setup when a custom category is selected. Bots guess in those and honestly score 0.",
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os robôs não conhecem as suas categorias: eles chutam uma resposta e marcam 0."
          }
        }
      }
    },
    "Bots take their time and call STOP after a minute or more. Good for learning." : {
      "comment" : "Description of the Relaxed bot speed. Keep the word STOP as is.",
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os robôs vão com calma e pedem STOP depois de um minuto ou mais. Bom para aprender."
          }
        }
      }
    },
    "Called by %@" : {
      "comment" : "Caption under the full-screen STOP! stamp. %@ is a list of player names, e.g. \"Ana and Bia\".",
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "STOP de %@"
          }
        }
      }
    },
    "Cancel" : {
      "comment" : "Cancels the current screen or confirmation.",
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cancelar"
          }
        }
      }
    },
    "Categories (%lld)" : {
      "comment" : "Section title with the number of categories in the game.",
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Categorias (%lld)"
          }
        }
      }
    },
    "Collecting answers…" : {
      "comment" : "Title of the screen between the end of a round and scoring.",
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recolhendo as respostas…"
          }
        }
      }
    },
    "Continue" : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Continuar"
          }
        }
      },
      "comment" : "Onboarding button that saves the player's name."
    },
    "Continue anyway" : {
      "comment" : "Host-only button: start scoring without the answers still missing.",
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Continuar mesmo assim"
          }
        }
      }
    },
    "Create game" : {
      "comment" : "Game setup button that creates the game and opens the lobby.",
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Criar jogo"
          }
        }
      }
    },
    "Done" : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OK"
          }
        }
      },
      "comment" : "Button that closes the Settings sheet."
    },
    "Don’t see your friend’s game? Make sure you’re both on the same Wi-Fi network." : {
      "comment" : "Footer under the list of nearby games.",
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não está vendo o jogo do seu amigo? Confira se vocês estão na mesma rede Wi-Fi."
          }
        }
      }
    },
    "Draws another letter for everyone and restarts the countdown." : {
      "comment" : "VoiceOver hint of the host's New letter button.",
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sorteia outra letra para todo mundo e reinicia a contagem."
          }
        }
      }
    },
    "End game" : {
      "comment" : "Host action that ends the game for everyone.",
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encerrar jogo"
          }
        }
      }
    },
    "End practice" : {
      "comment" : "Game menu item and confirm button that ends a practice game.",
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encerrar treino"
          }
        }
      }
    },
    "End round" : {
      "comment" : "Confirm button for force-ending the round.",
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encerrar rodada"
          }
        }
      }
    },
    "End the game for everyone?" : {
      "comment" : "Confirmation title when the host taps Leave game.",
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encerrar o jogo para todos?"
          }
        }
      }
    },
    "End the game?" : {
      "comment" : "Confirmation title for the host's End game (game menu and round results).",
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encerrar o jogo?"
          }
        }
      }
    },
    "End the practice?" : {
      "comment" : "Title of the alert confirming ending a practice game.",
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encerrar o treino?"
          }
        }
      }
    },
    "End this round now?" : {
      "comment" : "Confirmation title for Force end round.",
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encerrar esta rodada agora?"
          }
        }
      }
    },
    "Ends the round for you and sends your answers." : {
      "comment" : "VoiceOver hint for the STOP button when it's enabled.",
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encerra a rodada para você e envia suas respostas."
          }
        }
      }
    },
    "Ends your round with the answers you have." : {
      "comment" : "VoiceOver hint for the Give up button.",
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encerra sua rodada com as respostas que você tem."
          }
        }
      }
    },
    "Everyone goes to the final standings." : {
      "comment" : "Confirmation message for End game.",
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos vão para a classificação final."
          }
        }
      }
    },
    "Everyone has scored!" : {
      "comment" : "Scoring: every player has scored this category. Picks can still change until the host moves on.",
