      "comment" : "VoiceOver hint for the Join a game button on Home."
    },
    "Free and open source. No ads, no accounts, no tracking." : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gratuito e de código aberto. Sem anúncios, sem contas, sem rastreamento."
          }
        }
      },
      "comment" : "About screen tagline."
    },
    "Friends see this name when you play together." : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seus amigos veem esse nome quando vocês jogam juntos."
          }
        }
      },
      "comment" : "Explains what the player's name is used for."
    },
    "Game" : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
