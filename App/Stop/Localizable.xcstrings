{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ leaves the game. Their points so far stay in the standings." : {
      "comment" : "Message when the host confirms removing a player. %@ is the player's name.",
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ sai do jogo. Os pontos até agora continuam na classificação."
          }
        }
      }
    },
    "%@ · In progress" : {
      "comment" : "Join list detail for a game that already started. %@ is the player count, e.g. \"5 players\".",
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ · Em andamento"
          }
        }
      }
    },
    "%@’s game" : {
      "comment" : "Name of a game in the Join list and the lobby title for guests. %@ is the host's name.",
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jogo de %@"
          }
        }
      }
    },
