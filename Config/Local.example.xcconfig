// Copy to Config/Local.xcconfig (git-ignored) and fill in your own values.
// Needed only to run on a device or archive for the App Store; the simulator needs nothing.

// Your Apple Developer team ID (developer.apple.com → Membership details).
DEVELOPMENT_TEAM = YOUR_TEAM_ID

// Building under your own team? Bundle identifiers are unique across Apple, so also set
// PRODUCT_BUNDLE_IDENTIFIER here, e.g.:
// PRODUCT_BUNDLE_IDENTIFIER = com.example.stopapp
